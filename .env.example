# Copy to .env. Never commit .env, never paste keys into chat.

# --- Model ----------------------------------------------------------------
# foundry-local | azure | custom
PROVIDER=foundry-local

# Foundry Local assigns a port per install. Check: foundry server status
MODEL_BASE_URL=http://127.0.0.1:52999/v1
MODEL_NAME=phi-4-mini

# --- Email source ---------------------------------------------------------
# files | graph
#
# "graph" is WRITTEN BUT NEVER VERIFIED — Mail.Read consent was refused by an
# administrator in both tenants tried. See FINDINGS.md F6. Use "files".
EMAIL_SOURCE=files

# GRAPH_CLIENT_ID=
# GRAPH_TENANT_ID=common

# --- Behaviour ------------------------------------------------------------
# Send a reply without human review when the FAQ match scores at least this.
# This is the SEARCH's confidence, not the model's — it is auditable.
AUTO_SEND_THRESHOLD=0.55

# Below this, treat the FAQ as having no answer and log a knowledge-base gap.
MATCH_FLOOR=0.35

# Master switch. Safe ON with EMAIL_SOURCE=files (nothing leaves the machine).
# Turn OFF before pointing at a real mailbox, and get sign-off first.
AUTO_SEND=true

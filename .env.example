# Copy to .env

# --- Model ----------------------------------------------------------------
# foundry-local | azure | custom
PROVIDER=foundry-local

# Foundry Local assigns a port per install. Check: foundry server status
MODEL_BASE_URL=http://127.0.0.1:52999/v1
MODEL_NAME=phi-4-mini

# --- Email source ---------------------------------------------------------
# files | graph
#
# "graph" is untested. Use "files".
EMAIL_SOURCE=files

# GRAPH_CLIENT_ID=
# GRAPH_TENANT_ID=common

# --- Behaviour ------------------------------------------------------------
# Auto-send if the FAQ match score is at least this
AUTO_SEND_THRESHOLD=0.55

# Below this, log it as a gap in the FAQ
MATCH_FLOOR=0.35

# Turn off before using a real mailbox
AUTO_SEND=true
